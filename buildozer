[app]
title = JARVIS
package.name = jarvis
package.domain = com.chefe.jarvis
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3==3.10.13,kivy==2.3.0,plyer
orientation = portrait
fullscreen = 0
android.permissions = CAMERA,FLASHLIGHT
android.api = 33
android.minapi = 21
android.ndk = 25b
android.accept_sdk_license_agreement = True

[buildozer]
log_level = 2
warn_on_root = 1
